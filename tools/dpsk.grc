options:
  parameters:
    author: dernasherbrezon
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Debug flowgraph for investigating a suspected DPSK signal. Lets you
      slide the frequency-xlating center frequency, filter cutoff/transition and decimation
      while watching the raw and post-xlating spectra update live, then carries the
      signal through Costas carrier recovery, symbol timing recovery and differential
      demodulation down to decoded bits.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: dpsk
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: DPSK investigation
    window_size: (1600,1150)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: center_freq
  id: variable_qtgui_range
  parameters:
    comment: 'TUNE THIS: shifts the signal of interest to baseband before the low-pass
      filter/decimation.'
    gui_hint: 0,0,1,1
    label: Center frequency (Hz)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: -samp_rate / 2
    step: '100'
    stop: samp_rate / 2
    value: '18500'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [304, 356.0]
    rotation: 0
    state: enabled
- name: clock_loop_bw
  id: variable_qtgui_range
  parameters:
    comment: Symbol timing (clock recovery) loop bandwidth. Lower = smoother but slower
      timing tracking.
    gui_hint: 7,0,1,1
    label: Clock recovery loop bandwidth
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.001'
    step: '0.001'
    stop: '0.2'
    value: '0.003'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1096, 476.0]
    rotation: 0
    state: enabled
- name: costas_loop_bw
  id: variable_qtgui_range
  parameters:
    comment: Costas loop bandwidth (rad/sample) tracking residual carrier phase/frequency
      after xlating. Lower = slower but less noisy phase tracking. Watch the debug
      constellation to judge lock.
    gui_hint: 4,0,1,1
    label: Costas loop bandwidth
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.001'
    step: '0.001'
    stop: '0.5'
    value: '0.003'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [792, 364.0]
    rotation: 0
    state: enabled
- name: costas_loop_bw_2
  id: variable_qtgui_range
  parameters:
    comment: Bandwidth of the second Costas loop, applied after symbol timing recovery
      (one sample/symbol). Cleans up residual carrier phase/frequency the first loop
      didn't fully track before differential decoding.
    gui_hint: 8,0,1,1
    label: Costas loop 2 bandwidth
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.001'
    step: '0.001'
    stop: '0.5'
    value: '0.003'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1384, 316.0]
    rotation: 0
    state: enabled
- name: cutoff_freq
  id: variable_qtgui_range
  parameters:
    comment: Low-pass cutoff (Hz) applied after xlating, before decimation.
    gui_hint: 1,0,1,1
    label: Cutoff frequency (Hz)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '1000'
    step: '1000'
    stop: samp_rate / 4
    value: '3000'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [304, 476.0]
    rotation: 0
    state: enabled
- name: decim
  id: variable_qtgui_range
  parameters:
    comment: Decimation applied by the xlating filter.
    gui_hint: 3,0,1,1
    label: Decimation
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: int
    start: '1'
    step: '1'
    stop: '50'
    value: '20'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [304, 716.0]
    rotation: 0
    state: enabled
- name: rolloff
  id: variable_qtgui_range
  parameters:
    comment: RRC roll-off / excess bandwidth (alpha) for the optional matched filter
      stage. Only meaningful once Symbol rate is confirmed correct; common transmitter
      values are 0.35 or 0.5.
    gui_hint: 5,0,1,1
    label: RRC roll-off (alpha)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.1'
    step: '0.01'
    stop: '1.0'
    value: '0.35'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [792, 484.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: Sample rate of the input file. Must match the capture.
    value: '96000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [136, 8.0]
    rotation: 0
    state: enabled
- name: symbol_rate
  id: variable_qtgui_range
  parameters:
    comment: 'TUNE THIS: expected symbol/baud rate (Hz) of the DPSK signal. Feeds
      the symbol-sync samples-per-symbol calculation.'
    gui_hint: 6,0,1,1
    label: Symbol rate (baud)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '100'
    step: '100'
    stop: samp_rate / decim / 2
    value: '1200'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1088, 364.0]
    rotation: 0
    state: enabled
- name: transition_width
  id: variable_qtgui_range
  parameters:
    comment: Low-pass transition width (Hz) for the xlating filter taps.
    gui_hint: 2,0,1,1
    label: Transition width (Hz)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '2000'
    step: '500'
    stop: '10000'
    value: '5000'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [304, 596.0]
    rotation: 0
    state: enabled
- name: variable_low_pass_filter_taps_0
  id: variable_low_pass_filter_taps
  parameters:
    beta: '6.76'
    comment: ''
    cutoff_freq: cutoff_freq
    gain: '1.0'
    samp_rate: samp_rate
    value: ''
    width: transition_width
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [208, 12.0]
    rotation: 0
    state: enabled
- name: variable_rrc_filter_taps_0
  id: variable_rrc_filter_taps
  parameters:
    alpha: rolloff
    comment: RRC matched-filter taps. Only valid once Symbol rate matches the actual
      baud rate - wrong symbol_rate here distorts the passband instead of matching
      it.
    gain: '1.0'
    ntaps: int(11 * samp_rate / decim / symbol_rate)
    samp_rate: samp_rate / decim
    sym_rate: symbol_rate
    value: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [336, 12.0]
    rotation: 0
    state: enabled
- name: analog_agc_xx_0
  id: analog_agc_xx
  parameters:
    affinity: ''
    alias: ''
    comment: Normalizes amplitude before the Costas loop so its error detector behaves
      consistently.
    gain: '1.0'
    max_gain: '65536'
    maxoutbuf: '0'
    minoutbuf: '0'
    rate: 2e-2 / 80
    reference: '1.0'
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [608, 136.0]
    rotation: 0
    state: enabled
- name: blocks_file_source_0
  id: blocks_file_source
  parameters:
    affinity: ''
    alias: ''
    begin_tag: pmt.PMT_NIL
    comment: Point this at your .cf32 capture (complex float32 I/Q).
    file: /Users/dernasherbrezon/Downloads/satellites_backup/funcube-3/output.raw
    length: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    repeat: 'True'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 128.0]
    rotation: 0
    state: enabled
- name: blocks_null_sink_0
  id: blocks_null_sink
  parameters:
    affinity: ''
    alias: ''
    bus_structure_sink: '[[0,],]'
    comment: Decoded DPSK bits. Replace with a file sink to capture them.
    num_inputs: '1'
    type: byte
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2000, 156.0]
    rotation: 0
    state: enabled
- name: blocks_throttle2_0
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate * decim
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [208, 144.0]
    rotation: 0
    state: enabled
- name: digital_constellation_decoder_cb_0
  id: digital_constellation_decoder_cb
  parameters:
    affinity: ''
    alias: ''
    comment: Slices the differentially-decoded symbol back to a bit using a BPSK constellation.
    constellation: digital.constellation_bpsk().base()
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1800, 156.0]
    rotation: 0
    state: enabled
- name: digital_costas_loop_cc_0
  id: digital_costas_loop_cc
  parameters:
    affinity: ''
    alias: ''
    comment: Second-order Costas loop tracks residual carrier phase/frequency after
      xlating (order 2 is correct for DPSK, since it is differentially-encoded BPSK).
    maxoutbuf: '0'
    minoutbuf: '0'
    order: '2'
    use_snr: 'False'
    w: costas_loop_bw
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [808, 124.0]
    rotation: 0
    state: enabled
- name: digital_costas_loop_cc_1
  id: digital_costas_loop_cc
  parameters:
    affinity: ''
    alias: ''
    comment: Second Costas loop, applied after symbol timing recovery once there is
      one sample per symbol. Cleans up residual carrier phase/frequency the first
      loop didn't fully track before differential decoding.
    maxoutbuf: '0'
    minoutbuf: '0'
    order: '2'
    use_snr: 'False'
    w: costas_loop_bw_2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1360, 124.0]
    rotation: 0
    state: enabled
- name: digital_diff_phasor_cc_0
  id: digital_diff_phasor_cc
  parameters:
    affinity: ''
    alias: ''
    comment: Differential demodulation - multiplies each symbol by the conjugate of
      the previous one, which removes any residual/ambiguous absolute phase left by
      the Costas loop.
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1608, 148.0]
    rotation: 0
    state: enabled
- name: digital_symbol_sync_xx_0
  id: digital_symbol_sync_xx
  parameters:
    affinity: ''
    alias: ''
    comment: Clock recovery - resamples the Costas-corrected stream down to one complex
      sample per symbol.
    constellation: digital.constellation_bpsk().base()
    damping: '1.0'
    loop_bw: clock_loop_bw
    max_dev: '1.5'
    maxoutbuf: '0'
    minoutbuf: '0'
    nfilters: '32'
    osps: '1'
    pfb_mf_taps: '[]'
    resamp_type: digital.IR_PFB_NO_MF
    sps: samp_rate / decim / symbol_rate
    ted_gain: '1.0'
    ted_type: digital.TED_GARDNER
    type: cc
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1032, 124.0]
    rotation: 0
    state: enabled
- name: fir_filter_xxx_0
  id: fir_filter_xxx
  parameters:
    affinity: ''
    alias: ''
    comment: Optional RRC matched filter - complements (does not replace) the low-pass
      in the xlating filter above, which only isolates the channel. Only helps once
      Symbol rate/roll-off are confirmed and the transmitter is known to use RRC pulse
      shaping; with a wrong Symbol rate it just adds mild extra shaping rather than
      breaking anything. To turn it off, right-click and Bypass here - but then leave
      the RRC roll-off slider alone, since moving it while bypassed hits a GRC codegen
      bug (this block is skipped from instantiation but the roll-off slider callback
      still calls into it, throwing AttributeError).
    decim: decim
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_delay: '0'
    taps: variable_rrc_filter_taps_0
    type: ccf
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [544, 48.0]
    rotation: 0
    state: enabled
- name: freq_xlating_fir_filter_xxx_0
  id: freq_xlating_fir_filter_xxx
  parameters:
    affinity: ''
    alias: ''
    center_freq: center_freq
    comment: Shifts center_freq to baseband, low-pass filters and decimates.
    decim: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    taps: variable_low_pass_filter_taps_0
    type: ccc
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [376, 140.0]
    rotation: 0
    state: enabled
- name: qtgui_const_sink_x_0
  id: qtgui_const_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    axislabels: 'True'
    color1: '"blue"'
    color10: '"dark blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    comment: Debug view of the Costas loop output. When locked on DPSK/BPSK, points
      should cluster into 2 tight groups on a line through the origin instead of spreading
      around a circle.
    grid: 'True'
    gui_hint: 4,1,2,1
    label1: ''
    label10: ''
    label2: ''
    label3: ''
    label4: ''
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    legend: 'True'
    marker1: '0'
    marker10: '0'
    marker2: '0'
    marker3: '0'
    marker4: '0'
    marker5: '0'
    marker6: '0'
    marker7: '0'
    marker8: '0'
    marker9: '0'
    name: '"Costas loop constellation"'
    nconnections: '1'
    size: '1024'
    style1: '0'
    style10: '0'
    style2: '0'
    style3: '0'
    style4: '0'
    style5: '0'
    style6: '0'
    style7: '0'
    style8: '0'
    style9: '0'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: complex
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    xmax: '2'
    xmin: '-2'
    ymax: '2'
    ymin: '-2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [952, 364.0]
    rotation: 0
    state: enabled
- name: qtgui_const_sink_x_0_0
  id: qtgui_const_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    axislabels: 'True'
    color1: '"blue"'
    color10: '"dark blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    comment: Debug view of the Costas loop output. When locked on DPSK/BPSK, points
      should cluster into 2 tight groups on a line through the origin instead of spreading
      around a circle.
    grid: 'True'
    gui_hint: 8,1,1,1
    label1: ''
    label10: ''
    label2: ''
    label3: ''
    label4: ''
